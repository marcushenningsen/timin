{#
/**
 * @file timesheet.html.twig
 * Default theme implementation to present Timesheet data.
 *
 * This template is used when viewing Timesheet pages.
 *
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_timesheet()
 *
 * @ingroup themeable
 */
#}
<div{{ attributes.addClass('timesheet') }}>
  {% if content %}
    {{- content -}}
  {% endif %}
</div>

