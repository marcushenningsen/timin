function timin_timetracking_update_10002() {
  $spec1 = [
		'type' => 'int',
		'unsigned' => TRUE,
		'not null' => TRUE,
  ]; 
  $pk1 = [
    'timesheet_id',
    'service_type_id',
  ];
	$schema = Database::getConnection()->schema();
	$schema->dropIndex('timesheet_works', 'service_type_id');
	$schema->dropPrimaryKey('timesheet_works');
	$schema->dropField('timesheet_works', 'delta');
	$schema->changeField('timesheet_works', 'id', 'timesheet_id', $spec1);
	$schema->addPrimaryKey('timesheet_works', $pk1);
}
 
function timin_timetracking_update_10003() {
  $pk1 = [
    'timesheet_id',
    'service_type_id',
  ];

  $spec2 = [
		'type' => 'int',
		'unsigned' => TRUE,
		'not null' => TRUE,
  ];

  $pk2 = [
    'timesheet_id',
    'service_type_id',
    'employee_id'
  ];
 
 
	$schema = Database::getConnection()->schema();
	$schema->addPrimaryKey('timesheet_works', $pk1);
	$schema->dropPrimaryKey('timesheet_data');
	$schema->dropField('timesheet_data', 'delta');
	$schema->changeField('timesheet_data', 'id', 'timesheet_id', $spec2);
	$schema->addPrimaryKey('timesheet_data', $pk2);
}


