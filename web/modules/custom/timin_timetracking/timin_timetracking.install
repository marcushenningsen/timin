function timin_timetracking_schema() {
  $schema['timesheet_works'] = array(
    'fields' => [
      'timesheet_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'service_type_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'works_description' => [
        'type' => 'text',
        'null' => TRUE,
      ],
    ],
    'primary key' => [
      'timesheet_id',
      'service_type_id',
    ],
  );

  $schema['timesheet_data'] = array(
    'fields' => [
      'timesheet_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'service_type_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'employee_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'date' => [
        'type' => 'varchar',
        'mysql_type' => 'date',
        'not null' => TRUE,
      ],
      'project_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'time' => [
        'type' => 'numeric',
        'precision' => 10, 
        'scale' => 1, 
      ],
    ],
    'primary key' => [
      'timesheet_id',
      'service_type_id',
      'employee_id',
    ],
    'indexes' => [
      'date' => [
        'date',
      ],
      'project_id' => [
        'project_id',
      ],
      'employee_id' => [
        'employee_id',
      ],
    ],
  );
 
  return $schema;
}


